# =============================================
# DISCORD SCRAPER - Environment Configuration
# =============================================

# --- Discord Bot ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/discord_scraper

# --- Redis Cache ---
REDIS_URL=redis://127.0.0.1:6379

# --- AI (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
# AI_MODEL=gpt-4o-mini

# --- GitHub (optional) ---
GITHUB_TOKEN=your_github_pat_here

# --- JWT Auth ---
JWT_SECRET=change_me_to_a_long_random_string

# --- Server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Registration ---
ALLOW_REGISTRATION=true

# --- Subnet Scheduler ---
# Timezone for the daily subnet analysis (runs at 00:00 / midnight in this zone).
# Defaults to UTC if unset. Use an IANA timezone name.
# Local dev example:      Asia/Karachi
# Idaho (Mac mini) server: America/Boise
SUBNET_SCHEDULE_TZ=America/Boise

# On backend startup, run today's batch if it hasn't run yet (covers reboots /
# server being off at midnight). Set to "false" to disable. Default: enabled.
SUBNET_RUN_ON_STARTUP=true
