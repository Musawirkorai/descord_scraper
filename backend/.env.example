# =============================================
# DISCORD SCRAPER - Environment Configuration
# =============================================

# --- Discord Bot ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/discord_scraper

# --- Redis Cache ---
REDIS_URL=redis://127.0.0.1:6379

# --- AI PROVIDER ---
# Which LLM backend to use: "gemini" (default when GEMINI_API_KEY is set) or
# "groq". Leave unset and it prefers Gemini, falling back to Groq.
#
# WHY GEMINI IS THE DEFAULT
# One subnet report makes 5 sequential calls and a single call sends ~20-30k
# input tokens. Groq's FREE tier for gpt-oss-120b allows 8k tokens PER MINUTE
# and 200k per day, so one call is ~3x the whole per-minute budget and a day's
# batch (~15 calls) is several times the daily budget — it cannot finish a run,
# which surfaces as "no report created". Gemini's free tier is bounded by
# requests/day (~250 for Flash), so ~15 calls/day fits with room to spare.
LLM_PROVIDER=gemini

# --- Google AI Studio (Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: several keys, comma separated, tried in order with cooldown on 429.
# Gemini quota is per PROJECT, so keys from genuinely separate Google Cloud
# projects do add capacity. (Groq's quota is per ORGANIZATION, so extra Groq
# keys from one account add nothing — see backend/src/services/groqPool.js.)
# GEMINI_API_KEYS=key_one,key_two

# Model id. gemini-2.5-flash is free-tier and has a 1M context. If this ever
# 404s, list what your key can reach with:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" #     https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_MODEL=gemini-2.5-flash

# PRIVACY NOTE: Google's FREE tier may use submitted content to improve their
# products, and reviewers can annotate inputs/outputs. Paid tier and Vertex do
# not. Message content is stripped of usernames/mentions before it reaches the
# model (see cleanMessageContent in services/aiService.js), but the discussion
# itself still leaves your infrastructure. Use a paid key if that matters.

# --- Groq (alternative / fallback) ---
# Only used when LLM_PROVIDER=groq, or when no Gemini key is set.
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL: several free-tier keys, comma separated. NOTE: Groq rate limits are
# per organization, not per key, so multiple keys from ONE account do not raise
# your ceiling. Kept for compatibility.
# GROQ_API_KEYS=gsk_key_one,gsk_key_two

# Groq model id. Groq retires models periodically — llama-3.3-70b-versatile was
# decommissioned and now returns 404 model_not_found. Check with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# GROQ_MODEL=openai/gpt-oss-120b

# How long to block when EVERY key is cooling down. Rotation between keys is
# always instant; this caps only the waiting. A tokens-per-day limit resets hours
# later, so past this ceiling the run fails fast instead of hanging. Default 60000.
# LLM_MAX_WAIT_MS=60000

# --- ANALYSIS VOLUME (optional) ---
# How much of the 30-day window actually reaches the model. Defaults scale with
# the provider's context: generous on Gemini's 1M context, small on Groq's 131k.
# Raising these on Groq will cause hard rate-limit failures.
# ANALYSIS_SAMPLE_THRESHOLD=6000   # above this many messages, start sampling
# ANALYSIS_SAMPLE_SIZE=4000        # how many messages sampling keeps
# ANALYSIS_MESSAGE_LIMIT=6000      # ceiling on messages fetched when not sampling
# ANALYSIS_MESSAGE_CHARS=2000      # per-message character cap
# ANALYSIS_FILE_CHARS=4000         # per-attachment character cap
# ANALYSIS_GITHUB_LIMIT=2000       # ceiling on GitHub items
# ANALYSIS_GITHUB_CHARS=2000       # per-GitHub-item character cap

# --- GitHub (optional) ---
GITHUB_TOKEN=your_github_pat_here

# --- JWT Auth ---
JWT_SECRET=change_me_to_a_long_random_string

# --- Server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Frontend ---
# Comma-separated list of allowed browser origins (CORS). Include the deployed
# dashboard origin in production, e.g.
#   FRONTEND_URL=https://dashboard.example.com,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Registration ---
ALLOW_REGISTRATION=true

# --- Subnet Scheduler ---
# Timezone for the daily subnet analysis (runs at 00:00 / midnight in this zone).
# Defaults to UTC if unset. Use an IANA timezone name.
# Local dev example:      Asia/Karachi
# Idaho (Mac mini) server: America/Boise
SUBNET_SCHEDULE_TZ=America/Boise

# On backend startup, run today's batch if it hasn't run yet (covers reboots /
# server being off at midnight). Set to "false" to disable. Default: enabled.
SUBNET_RUN_ON_STARTUP=true
